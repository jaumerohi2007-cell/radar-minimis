# Copia este fichero a `.env` (nunca lo subas al repositorio).

# Modo de cobro: validation (por defecto, sin cobros: «puerta falsa» + lista de espera) o stripe (tras el alta fiscal)
BILLING_MODE=validation

# URLs públicas
RM_SITE_URL=https://www.example.com
# Vacío = la API vive en el mismo origen (Cloudflare Pages Functions o `serve` local)
RM_API_URL=
# Vacío = lista de espera y eventos en el mismo origen que el sitio
RM_LEADS_API_URL=
RM_ALLOWED_ORIGINS=https://www.example.com

# Titular del sitio (aviso legal y cláusula de privacidad de la lista de espera): OBLIGATORIO antes de publicar
RM_LEGAL_OWNER=Nombre Apellidos o Razón Social, NIF
RM_PRIVACY_EMAIL=privacidad@example.com
# NIF del titular (LSSI art. 10): aparece en el aviso legal y en las condiciones de contratación
RM_LEGAL_NIF=
# Clave IndexNow (pública por diseño: se publica en /{clave}.txt). Vacía = no se avisa a Bing
RM_INDEXNOW_KEY=
# Contacto incluido en el User-Agent hacia la BDNS (buena práctica de datos abiertos)
RM_CONTACT_EMAIL=contacto@example.com

# Rutas (por defecto: src/data/radar.db y src/site_dist)
# RM_DB_PATH=/opt/radar-minimis/data/radar.db
# RM_SITE_DIR=/opt/radar-minimis/site_dist

# Cliente BDNS: ritmo educado
RM_BDNS_RATE_PER_SEC=2
RM_BDNS_TIMEOUT_S=60
RM_MINIMIS_CACHE_TTL_H=24

# Sitio pSEO (Cloudflare Pages Free admite 20.000 ficheros por despliegue)
RM_SITE_MAX_PAGES=15000
RM_SITE_WINDOW_DAYS=120

# Plan gratuito
RM_FREE_LOOKUPS_PER_DAY=10
# Grupo «única empresa» gratuito (CIF principal + vinculados). La interfaz muestra 3 huecos de vinculados.
RM_FREE_GROUP_MAX_CIFS=2
RM_PRO_LINKED_SLOTS=3

# Pesca: 40000 en España (RD 1139/2024, art. 3.2 bis Reg. 717/2014); 30000 = régimen base
RM_TOPE_PESCA_EUR=40000

# Cobros y email (solo con BILLING_MODE=stripe, tras el alta fiscal)
RM_STRIPE_PAYMENT_LINK=
RM_STRIPE_WEBHOOK_SECRET=
RM_RESEND_API_KEY=
RM_MAIL_FROM=Radar Minimis <alertas@example.com>
