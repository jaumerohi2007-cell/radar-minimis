# /etc/caddy/Caddyfile — TLS automático (Let's Encrypt) delante de la API.
# Sustituye el dominio por el tuyo y apunta su registro A/AAAA a la IP del VPS.
api.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
